model Payment {
  id String @id @default(uuid())

  bookingId String 
  booking   Booking @relation(fields: [bookingId],references: [id],onDelete: Cascade,onUpdate: Cascade)

  userId String
  user   Users @relation(fields: [userId],references: [id],onDelete: Cascade,onUpdate: Cascade)

  subBookingId String
  subBooking SubRoomBooking @relation(fields: [subBookingId],references: [id],onDelete: Cascade,onUpdate: Cascade)

  amount Decimal @db.Decimal(10, 2)

  currency String @default("BDT") @db.VarChar(3)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentType   PaymentType
  merchantInvoiceNumber String         @unique
  bkashPaymentID        String?        @unique
  bkashTrxID            String?        @unique
  payerReference        String?
  gatewayResponse Json?
  paidAt DateTime?
  refundTrxID           String?        @unique
  refundAmount          Decimal?       @db.Decimal(10, 2)
  refundAt              DateTime?
  refundReason          String?
  failedAt DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([bookingId])

  @@map("payments")
}
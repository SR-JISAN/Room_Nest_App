model RoomImage {
  id String @id @default(uuid())

  roomImageURL      String? @default("")
  roomImagePublicId String? @default("")

  roomId String
  room   Rooms  @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@map("roomImage")
}

model Reviews {
    id String @id @default(uuid())
    name String
    email String
    note   String @db.VarChar(300)
    reviewRating  ReviewRating @default(ONE)
    roomId String 
    room Rooms @relation(fields: [roomId],references: [id],onDelete: Cascade,onUpdate: Cascade)
    userId String
    user Users @relation(fields: [userId],references: [id],onDelete: Cascade,onUpdate: Cascade)
    createdAt          DateTime     @default(now())
    updatedAt          DateTime     @updatedAt


@@index([reviewRating,userId,roomId])
@@map("reviews")
}
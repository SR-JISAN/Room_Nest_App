model Rooms {
  id String @id @default(uuid())

  title       String
  description String

  roomType RoomType

  rentAmount      Decimal @db.Decimal(10, 2)
  securityDeposit Decimal @db.Decimal(10, 2)

  roomStatus RoomStatus @default(AVAILABLE)

  propertyId String
  property   Properties @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  roomImages    RoomImage[]
  roomAmenities RoomAmenities[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([roomType, rentAmount, roomStatus])
  @@map("rooms")
}

model PropertyImage {
  id String @id @default(uuid())

  propertyImageURL      String? @default("")
  propertyImagePublicId String? @default("")

  propertyId String
  property   Properties @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  
  @@index([propertyId])
  @@map("propertyImage")
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Password Updated - Room Nest</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    }

    .email-wrapper {
      width: 100%;
      padding: 40px 15px;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
    }

    .header {
      background-color: #111827;
      padding: 30px 25px;
      text-align: center;
    }

    .logo {
      color: #ffffff;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin: 0;
    }

    .logo span {
      color: #6366f1;
    }

    .header-text {
      color: #d1d5db;
      font-size: 14px;
      margin-top: 8px;
    }

    .content {
      padding: 40px 35px;
    }

    .icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background-color: #eef2ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      text-align: center;
      line-height: 64px;
    }

    .title {
      margin: 0 0 15px;
      text-align: center;
      font-size: 25px;
      color: #111827;
    }

    .greeting {
      font-size: 16px;
      line-height: 1.7;
      margin-bottom: 15px;
    }

    .message {
      font-size: 15px;
      line-height: 1.7;
      color: #4b5563;
      margin-bottom: 25px;
    }

    .info-box {
      background-color: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 18px;
      margin: 25px 0;
    }

    .info-row {
      margin: 8px 0;
      font-size: 14px;
    }

    .info-label {
      font-weight: 600;
      color: #374151;
    }

    .info-value {
      color: #6b7280;
    }

    .security-box {
      background-color: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 8px;
      padding: 16px;
      margin-top: 25px;
    }

    .security-title {
      margin: 0 0 7px;
      color: #9a3412;
      font-size: 14px;
      font-weight: 700;
    }

    .security-text {
      margin: 0;
      color: #7c2d12;
      font-size: 13px;
      line-height: 1.6;
    }

    .button-wrapper {
      text-align: center;
      margin: 30px 0;
    }

    .button {
      display: inline-block;
      background-color: #6366f1;
      color: #ffffff !important;
      text-decoration: none;
      padding: 13px 25px;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 600;
    }

    .footer {
      background-color: #f9fafb;
      border-top: 1px solid #e5e7eb;
      padding: 25px;
      text-align: center;
    }

    .footer-text {
      margin: 0;
      color: #9ca3af;
      font-size: 12px;
      line-height: 1.6;
    }

    .footer-brand {
      margin-bottom: 8px;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
    }

    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 20px 10px;
      }

      .content {
        padding: 30px 20px;
      }

      .title {
        font-size: 22px;
      }

      .header {
        padding: 25px 20px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <div class="email-container">

      <!-- Header -->
      <div class="header">
        <h1 class="logo">
          Room<span>Nest</span>
        </h1>

        <p class="header-text">
          Your trusted house & roommate platform
        </p>
      </div>

      <!-- Content -->
      <div class="content">

        <div class="icon">
          🔐
        </div>

        <h2 class="title">
          Password Updated Successfully
        </h2>

        <p class="greeting">
          Hello <strong><%= name %></strong>,
        </p>

        <p class="message">
          Your Room Nest account password has been successfully updated.
          You can now use your new password to sign in to your account.
        </p>

        <!-- Account Information -->
        <div class="info-box">

          <div class="info-row">
            <span class="info-label">Account:</span>
            <span class="info-value"><%= email %></span>
          </div>

          <div class="info-row">
            <span class="info-label">Action:</span>
            <span class="info-value">Password Changed</span>
          </div>

        </div>

        <!-- Login Button -->
        <div class="button-wrapper">
          <a
            href="<%= frontendUrl %>/login"
            class="button"
          >
            Login to Room Nest
          </a>
        </div>

        <!-- Security Notice -->
        <div class="security-box">

          <p class="security-title">
            Didn't change your password?
          </p>

          <p class="security-text">
            If you did not make this change, please secure your account
            immediately and contact Room Nest support.
          </p>

        </div>

      </div>

      <!-- Footer -->
      <div class="footer">

        <p class="footer-brand">
          Room Nest
        </p>

        <p class="footer-text">
          This is an automated security notification.
          Please do not reply directly to this email.
        </p>

        <p class="footer-text">
          &copy; <%= new Date().getFullYear() %> Room Nest. All rights reserved.
        </p>

      </div>

    </div>

  </div>

</body>
</html>
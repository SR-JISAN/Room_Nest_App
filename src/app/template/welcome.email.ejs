<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Welcome to Room Nest</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f4f7fb;
      color: #1f2937;
      padding: 30px 15px;
    }

    .email-wrapper {
      max-width: 600px;
      margin: 0 auto;
    }

    .email-container {
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
    }

    /* Header */
    .header {
      background-color: #2563eb;
      padding: 35px 25px;
      text-align: center;
    }

    .logo {
      color: #ffffff;
      font-size: 30px;
      font-weight: 700;
      letter-spacing: 1.5px;
    }

    .tagline {
      color: #dbeafe;
      font-size: 14px;
      margin-top: 8px;
    }

    /* Content */
    .content {
      padding: 40px 35px;
    }

    .welcome-title {
      font-size: 26px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 18px;
    }

    .description {
      font-size: 15px;
      line-height: 1.8;
      color: #6b7280;
      margin-bottom: 25px;
    }

    .user-card {
      background-color: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 18px;
      margin-bottom: 25px;
    }

    .user-card p {
      font-size: 14px;
      color: #4b5563;
      margin-bottom: 8px;
    }

    .user-card p:last-child {
      margin-bottom: 0;
    }

    .user-card strong {
      color: #111827;
    }

    /* Feature Section */
    .features-title {
      font-size: 17px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 15px;
    }

    .feature {
      margin-bottom: 12px;
      font-size: 14px;
      line-height: 1.6;
      color: #6b7280;
    }

    .feature strong {
      color: #374151;
    }

    /* CTA */
    .cta-wrapper {
      text-align: center;
      margin: 30px 0;
    }

    .cta {
      display: inline-block;
      background-color: #2563eb;
      color: #ffffff !important;
      text-decoration: none;
      padding: 13px 28px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    /* Security */
    .security {
      background-color: #eff6ff;
      border-left: 4px solid #2563eb;
      padding: 13px 15px;
      border-radius: 4px;
      margin-top: 25px;
    }

    .security p {
      color: #1e40af;
      font-size: 13px;
      line-height: 1.6;
    }

    .thanks {
      font-size: 14px;
      line-height: 1.7;
      color: #4b5563;
      margin-top: 25px;
    }

    /* Footer */
    .footer {
      background-color: #f9fafb;
      padding: 22px 20px;
      text-align: center;
      border-top: 1px solid #e5e7eb;
    }

    .footer p {
      font-size: 12px;
      color: #9ca3af;
      line-height: 1.7;
    }

    .footer a {
      color: #2563eb;
      text-decoration: none;
    }

    @media only screen and (max-width: 600px) {
      .content {
        padding: 30px 20px;
      }

      .welcome-title {
        font-size: 22px;
      }

      .header {
        padding: 30px 20px;
      }
    }
  </style>
</head>

<body>

  <div class="email-wrapper">

    <div class="email-container">

      <!-- Header -->
      <div class="header">

        <div class="logo">
          ROOM NEST
        </div>

        <div class="tagline">
          Find your perfect place to stay
        </div>

      </div>


      <!-- Content -->
      <div class="content">

        <h1 class="welcome-title">
          Welcome to Room Nest, <%= name %>! 👋
        </h1>

        <p class="description">
          We're excited to have you with us.

          Your Room Nest account has been successfully created,
          and you're now ready to explore a better way to find
          comfortable and convenient places to stay.
        </p>


        <!-- User Information -->
        <div class="user-card">

          <p>
            <strong>Name:</strong>
            <%= name %>
          </p>

          <p>
            <strong>Email:</strong>
            <%= email %>
          </p>

          <p>
            <strong>Account Status:</strong>
            Active
          </p>

        </div>


        <!-- Features -->
        <div>

          <h2 class="features-title">
            What you can do with Room Nest
          </h2>

          <p class="feature">
            ✓ <strong>Discover places</strong> — Explore rooms and
            properties that match your needs.
          </p>

          <p class="feature">
            ✓ <strong>Manage your account</strong> — Keep your profile
            and personal information up to date.
          </p>

          <p class="feature">
            ✓ <strong>Find your next home</strong> — Make your search
            easier and more convenient.
          </p>

        </div>


        <!-- CTA -->
        <div class="cta-wrapper">

          <a
            href="<%= frontendUrl %>"
            class="cta"
          >
            Explore Room Nest
          </a>

        </div>


        <!-- Security -->
        <div class="security">

          <p>
            <strong>Security Notice:</strong>
            If you did not create this account, please contact our
            support team immediately.
          </p>

        </div>


        <p class="thanks">

          Thank you for choosing
          <strong>Room Nest</strong>.

          We look forward to helping you find a place
          that feels like home.

          <br /><br />

          Best regards,<br />

          <strong>The Room Nest Team</strong>

        </p>

      </div>


      <!-- Footer -->
      <div class="footer">

        <p>
          © 2026 Room Nest. All rights reserved.
        </p>

        <p>
          This is an automated email. Please do not reply to this message.
        </p>

      </div>

    </div>

  </div>

</body>
</html>